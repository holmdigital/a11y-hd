{
    "name": "@holmdigital/a11y-monorepo",
    "version": "0.1.0",
    "private": true,
    "description": "Holm Digital Regulatory-Compliant Accessibility Ecosystem",
    "workspaces": [
        "packages/engine",
        "packages/components",
        "packages/standards"
    ],
    "overrides": {
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "esbuild": "^0.28.1"
    },
    "scripts": {
        "build": "npm run build -w @holmdigital/standards && npm run build -w @holmdigital/components && npm run build -w @holmdigital/engine",
        "dev": "npm run dev --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "test:ci": "npm run test:ci --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "clean": "npm run clean --workspaces --if-present && rimraf node_modules",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "scan:local": "node packages/engine/dist/cli/index.js scan http://localhost:3004",
        "release": "changeset publish --provenance"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^10.0.1",
        "@storybook/addon-a11y": "^10.5.5",
        "@storybook/react-vite": "^10.5.5",
        "@types/node": "^26.1.2",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.18.1",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.8.0",
        "prettier": "^3.9.6",
        "publint": "^0.3.22",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=22.22.0",
        "npm": ">=9.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/holmdigital/a11y-hd.git"
    },
    "author": "Holm Digital AB",
    "license": "MIT"
}
