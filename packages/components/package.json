{
    "name": "@holmdigital/components",
    "author": "Holm Digital AB",
    "version": "1.2.4",
    "private": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "description": "Prescriptive, accessible React components for regulatory compliance",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/holmdigital/a11y-hd.git",
        "directory": "packages/components"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./Button": {
            "types": "./dist/Button/Button.d.ts",
            "import": "./dist/Button/Button.mjs"
        },
        "./FormField": {
            "types": "./dist/FormField/FormField.d.ts",
            "import": "./dist/FormField/FormField.mjs"
        },
        "./Dialog": {
            "types": "./dist/Dialog/Dialog.d.ts",
            "import": "./dist/Dialog/Dialog.mjs"
        },
        "./Modal": {
            "types": "./dist/Modal/Modal.d.ts",
            "import": "./dist/Modal/Modal.mjs"
        },
        "./SkipLink": {
            "types": "./dist/SkipLink/SkipLink.d.ts",
            "import": "./dist/SkipLink/SkipLink.mjs"
        },
        "./NavigationMenu": {
            "types": "./dist/NavigationMenu/NavigationMenu.d.ts",
            "import": "./dist/NavigationMenu/NavigationMenu.mjs"
        },
        "./Checkbox": {
            "types": "./dist/Checkbox/Checkbox.d.ts",
            "import": "./dist/Checkbox/Checkbox.mjs"
        },
        "./RadioGroup": {
            "types": "./dist/RadioGroup/RadioGroup.d.ts",
            "import": "./dist/RadioGroup/RadioGroup.mjs"
        },
        "./Select": {
            "types": "./dist/Select/Select.d.ts",
            "import": "./dist/Select/Select.mjs"
        },
        "./Switch": {
            "types": "./dist/Switch/Switch.d.ts",
            "import": "./dist/Switch/Switch.mjs"
        },
        "./Toast": {
            "types": "./dist/Toast/Toast.d.ts",
            "import": "./dist/Toast/Toast.mjs"
        },
        "./Tooltip": {
            "types": "./dist/Tooltip/Tooltip.d.ts",
            "import": "./dist/Tooltip/Tooltip.mjs"
        },
        "./Heading": {
            "types": "./dist/Heading/Heading.d.ts",
            "import": "./dist/Heading/Heading.mjs"
        },
        "./AccessibilityStatement": {
            "types": "./dist/AccessibilityStatement/AccessibilityStatement.d.ts",
            "import": "./dist/AccessibilityStatement/AccessibilityStatement.mjs"
        },
        "./ErrorSummary": {
            "types": "./dist/ErrorSummary/ErrorSummary.d.ts",
            "import": "./dist/ErrorSummary/ErrorSummary.mjs"
        },
        "./Combobox": {
            "types": "./dist/Combobox/Combobox.d.ts",
            "import": "./dist/Combobox/Combobox.mjs"
        },
        "./DatePicker": {
            "types": "./dist/DatePicker/DatePicker.d.ts",
            "import": "./dist/DatePicker/DatePicker.mjs"
        },
        "./MultiSelect": {
            "types": "./dist/MultiSelect/MultiSelect.d.ts",
            "import": "./dist/MultiSelect/MultiSelect.mjs"
        },
        "./DataTable": {
            "types": "./dist/DataTable/DataTable.d.ts",
            "import": "./dist/DataTable/DataTable.mjs"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/Button/Button.tsx src/FormField/FormField.tsx src/Dialog/Dialog.tsx src/Modal/Modal.tsx src/SkipLink/SkipLink.tsx src/NavigationMenu/NavigationMenu.tsx src/Checkbox/Checkbox.tsx src/RadioGroup/RadioGroup.tsx src/Select/Select.tsx src/Switch/Switch.tsx src/Toast/Toast.tsx src/Tooltip/Tooltip.tsx src/Heading/Heading.tsx src/AccessibilityStatement/AccessibilityStatement.tsx src/ErrorSummary/ErrorSummary.tsx src/Combobox/Combobox.tsx src/DatePicker/DatePicker.tsx src/MultiSelect/MultiSelect.tsx src/DataTable/DataTable.tsx --format cjs,esm --dts --clean --external react --external @holmdigital/standards",
        "dev": "tsup src/index.ts src/Button/Button.tsx src/FormField/FormField.tsx src/Dialog/Dialog.tsx src/Modal/Modal.tsx src/SkipLink/SkipLink.tsx src/NavigationMenu/NavigationMenu.tsx src/Checkbox/Checkbox.tsx src/RadioGroup/RadioGroup.tsx src/Select/Select.tsx src/Switch/Switch.tsx src/Toast/Toast.tsx src/Tooltip/Tooltip.tsx src/Heading/Heading.tsx src/AccessibilityStatement/AccessibilityStatement.tsx src/ErrorSummary/ErrorSummary.tsx src/Combobox/Combobox.tsx src/DatePicker/DatePicker.tsx src/MultiSelect/MultiSelect.tsx src/DataTable/DataTable.tsx --format cjs,esm --dts --watch --external react --external @holmdigital/standards",
        "lint": "eslint src --ext .ts,.tsx",
        "test": "vitest",
        "test:ci": "vitest run",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "keywords": [
        "react",
        "components",
        "accessibility",
        "a11y",
        "wcag",
        "design-system",
        "ui-kit",
        "accessible-components",
        "wcag-compliant"
    ],
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "storybook": "^7.6.0",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "lucide-react": "^0.556.0",
        "@holmdigital/standards": "^1.2.3"
    }
}