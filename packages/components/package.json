    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint src --ext .ts,.tsx",
        "check:no-tailwind-leak": "node scripts/check-no-tailwind-leak.mjs",
        "check:no-test-leak": "node scripts/check-no-test-leak.mjs",
        "test": "vitest",
        "test:ci": "vitest run && npm run test:wcag-headers && npm run check:no-tailwind-leak && npm run check:no-test-leak",
        "test:wcag-headers": "node scripts/check-wcag-headers.mjs",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "keywords": [
        "react",
        "components",
        "accessibility",
        "a11y",
        "wcag",
        "design-system",
        "ui-kit",
        "accessible-components",
        "wcag-compliant"
    ],
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "lucide-react": ">=0.400.0"
    },
    "peerDependenciesMeta": {
        "lucide-react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@chialab/vitest-axe": "^0.19.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^18.2.0 || ^19.0.0",
        "@types/react-dom": "^18.2.0 || ^19.0.0",
        "axe-core": "^4.11.4",
        "eslint-plugin-testing-library": "^7.16.2",
        "jsdom": "^28.0.0",
        "lucide-react": "^0.556.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "storybook": "^10.2.13",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "@holmdigital/standards": "^2.3.0"
    }
