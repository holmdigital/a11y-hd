{
    "name": "@holmdigital/engine",
    "version": "2.9.0",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "description": "WCAG and EN 301 549 accessibility test engine that maps failures to national law and enforcement bodies across 17 jurisdictions. CLI and CI reporting.",
    "homepage": "https://wiki.holmdigital.se",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/holmdigital/a11y-hd.git",
        "directory": "packages/engine"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "bin": {
        "hd-a11y-scan": "./dist/cli/index.js"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./cli": {
            "import": {
                "types": "./dist/cli/index.d.mts",
                "default": "./dist/cli/index.mjs"
            },
            "require": {
                "types": "./dist/cli/index.d.ts",
                "default": "./dist/cli/index.js"
            }
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup && node scripts/copy-assets.mjs",
        "dev": "tsup --watch",
        "test": "vitest",
        "test:ci": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run verify",
        "check:exports": "publint --strict",
        "check:types": "attw --pack . --ignore-rules no-resolution",
        "verify": "npm run build && npm run lint && npm run typecheck && npm run check:exports && npm run check:types && npm run test:ci"
    },
    "keywords": [
        "accessibility",
        "a11y",
        "wcag",
        "en-301-549",
        "en301549",
        "eaa",
        "accessibility-testing",
        "cli",
        "compliance",
        "automation",
        "testing",
        "regulatory",
        "html-validate",
        "axe-core",
        "european-accessibility-act",
        "holmdigital",
        "section508",
        "ada",
        "dos-lagen",
        "digitale-barrierefreiheit"
    ],
    "author": "Holm Digital AB",
    "license": "MIT",
    "dependencies": {
        "@holmdigital/components": "^3.0.0",
        "@holmdigital/standards": "^2.8.0",
        "axe-core": "^4.12.1",
        "chalk": "^5.3.0",
        "commander": "^12.1.0",
        "cosmiconfig": "^9.0.2",
        "html-validate": "11.5.3",
        "ora": "^8.1.1",
        "puppeteer": "25.2.0",
        "react": "^18.3.1 || ^19.0.0",
        "react-dom": "^18.3.1 || ^19.0.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/cosmiconfig": "^5.0.3",
        "@types/node": "^26.0.0",
        "@types/react": "^18.3.1 || ^19.0.0",
        "@types/react-dom": "^18.3.1 || ^19.0.0",
        "@types/ws": "^8.5.13",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "vitest": "^4.1.9"
    }
}
