{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://holmdigital.dev/schema/national-laws.json",
    "title": "National Accessibility Laws Database",
    "description": "Schema for packages/standards/data/legal/national-laws.json. Validates structural integrity of country → laws[] mappings.",
    "type": "object",
    "required": ["laws"],
    "additionalProperties": false,
    "properties": {
        "laws": {
            "type": "object",
            "description": "Country code (ISO 3166-1 alpha-2) → array of national laws",
            "patternProperties": {
                "^[A-Z]{2}$": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/NationalLaw" }
                }
            },
            "additionalProperties": false
        }
    },
    "definitions": {
        "NationalLaw": {
            "type": "object",
            "required": [
                "id",
                "law",
                "fullName",
                "euFramework",
                "scope",
                "inForce",
                "effectiveDate"
            ],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "law": { "type": "string", "minLength": 1 },
                "fullName": { "type": "string", "minLength": 1 },
                "euFramework": { "enum": ["WAD", "EAA", "DDA", "ADA", "REHAB", "ACA"] },
                "scope": { "enum": ["public", "private", "both"] },
                "jurisdiction": { "enum": ["national", "subnational"] },
                "lawUrl": { "type": "string", "pattern": "^https?://" },
                "enforcement": { "$ref": "#/definitions/Enforcement" },
                "sectorAuthorities": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/SectorAuthority" }
                },
                "sanctions": {
                    "oneOf": [
                        { "$ref": "#/definitions/SanctionRange" },
                        { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/SanctionRange" } }
                    ]
                },
                "attestation": { "$ref": "#/definitions/Attestation" },
                "inForce": { "type": "boolean" },
                "effectiveDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "note": { "type": "string" },
                "complianceDeadlines": { "$ref": "#/definitions/ComplianceDeadlines" },
                "exemptions": { "$ref": "#/definitions/Exemptions" }
            }
        },
        "Enforcement": {
            "type": "object",
            "required": ["authority", "authorityName", "responsibility", "website"],
            "additionalProperties": false,
            "properties": {
                "authority": { "type": "string" },
                "authorityName": { "type": "string" },
                "responsibility": { "type": "string" },
                "website": { "type": "string", "pattern": "^https?://" }
            }
        },
        "SectorAuthority": {
            "type": "object",
            "required": ["authority", "responsibility"],
            "additionalProperties": false,
            "properties": {
                "authority": { "type": "string" },
                "responsibility": { "type": "string" }
            }
        },
        "SanctionRange": {
            "description": "Intern #70: one sanction a law provides, with its legal basis and source. legalBasis and sourceUrl are required on every element.",
            "oneOf": [
                {
                    "type": "object",
                    "required": ["kind", "type", "description", "currency", "cap", "legalBasis", "sourceUrl"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": { "const": "amount" },
                        "type": { "type": "string", "minLength": 1 },
                        "description": { "type": "string", "minLength": 1 },
                        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                        "liablePerson": { "enum": ["natural", "legal"] },
                        "severity": { "type": "string", "minLength": 1 },
                        "condition": { "type": "string", "minLength": 1 },
                        "cap": { "enum": ["stated", "elsewhere", "no-ceiling", "not-established"] },
                        "legalBasis": { "type": "string", "minLength": 1 },
                        "sourceUrl": { "type": "string", "pattern": "^https://" },
                        "example": { "type": "string", "minLength": 1 },
                        "minAmount": { "type": "number", "minimum": 0 },
                        "maxAmount": { "type": "number", "exclusiveMinimum": 0 }
                    }
                },
                {
                    "type": "object",
                    "required": ["kind", "type", "description", "currency", "cap", "legalBasis", "sourceUrl", "factor"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": { "const": "formula" },
                        "type": { "type": "string", "minLength": 1 },
                        "description": { "type": "string", "minLength": 1 },
                        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                        "liablePerson": { "enum": ["natural", "legal"] },
                        "severity": { "type": "string", "minLength": 1 },
                        "condition": { "type": "string", "minLength": 1 },
                        "cap": { "enum": ["stated", "elsewhere", "no-ceiling", "not-established"] },
                        "legalBasis": { "type": "string", "minLength": 1 },
                        "sourceUrl": { "type": "string", "pattern": "^https://" },
                        "example": { "type": "string", "minLength": 1 },
                        "factor": { "type": "number", "exclusiveMinimum": 0 },
                        "index": { "type": "string", "minLength": 1 },
                        "combine": { "enum": ["lesser-of", "greater-of"] }
                    }
                }
            ]
        },
        "Attestation": {
            "type": "object",
            "required": ["attestedBy", "session", "sources", "attested", "notAttested", "subject"],
            "additionalProperties": false,
            "properties": {
                "attestedBy": { "type": "string", "minLength": 1 },
                "session": { "type": "string", "minLength": 1 },
                "sources": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                },
                "attested": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/AttestableField" },
                    "uniqueItems": true
                },
                "notAttested": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/AttestableField" },
                    "uniqueItems": true
                },
                "subject": { "enum": ["law-entry", "enforcement-key", "no-entry"] }
            }
        },
        "AttestableField": {
            "enum": [
                "lagnamn",
                "lagrum",
                "tillsynsmyndighet",
                "sanktionsart",
                "sanktionsbelopp",
                "ikrafttradande",
                "scope",
                "jurisdiktion",
                "tillsynsordning",
                "sanktionsordning"
            ]
        },
        "ComplianceDeadlines": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "largeEntity": { "$ref": "#/definitions/ComplianceDeadlineEntry" },
                "smallEntity": { "$ref": "#/definitions/ComplianceDeadlineEntry" }
            }
        },
        "ComplianceDeadlineEntry": {
            "oneOf": [
                {
                    "type": "object",
                    "required": ["populationThreshold", "deadline", "description"],
                    "additionalProperties": false,
                    "properties": {
                        "populationThreshold": { "type": "integer", "minimum": 0 },
                        "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                        "description": { "type": "string" }
                    }
                },
                {
                    "type": "object",
                    "required": ["employeeThreshold", "deadline", "description"],
                    "additionalProperties": false,
                    "properties": {
                        "employeeThreshold": { "type": "integer", "minimum": 0 },
                        "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                        "description": { "type": "string" }
                    }
                }
            ]
        },
        "Exemptions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "microbusiness": { "$ref": "#/definitions/MicrobusinessExemption" },
                "statutory": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/StatutoryExemption" }
                }
            }
        },
        "StatutoryExemption": {
            "type": "object",
            "required": ["kind", "description", "legalBasis"],
            "additionalProperties": false,
            "properties": {
                "kind": { "enum": ["actor", "content", "disproportionate-burden", "transitional"] },
                "description": { "type": "string", "minLength": 1 },
                "legalBasis": { "type": "string", "minLength": 1 }
            }
        },
        "MicrobusinessExemption": {
            "type": "object",
            "required": [
                "employeeThreshold",
                "revenueThreshold",
                "revenueCurrency",
                "appliesTo",
                "description"
            ],
            "additionalProperties": false,
            "properties": {
                "employeeThreshold": { "type": "integer", "minimum": 0 },
                "revenueThreshold": { "type": "number", "minimum": 0 },
                "revenueCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                "appliesTo": { "enum": ["services", "products", "both"] },
                "description": { "type": "string" },
                "legalBasis": { "type": "string" }
            }
        }
    }
}
