{
    "name": "@holmdigital/standards",
    "version": "2.4.0",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "description": "Machine-readable regulatory database for WCAG, EN 301 549 and the DOS Act",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/holmdigital/a11y-hd.git",
        "directory": "packages/standards"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./data/*": "./data/*",
        "./schema/*": "./schema/*"
    },
    "files": [
        "dist",
        "data",
        "schema",
        "README.md"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "test": "vitest",
        "test:ci": "vitest run",
        "lint": "eslint src",
        "validate-schema": "node scripts/validate-schema.js",
        "validate-data": "node scripts/validate-data.js"
    },
    "keywords": [
        "accessibility",
        "a11y",
        "wcag",
        "en301549",
        "dos-lagen",
        "standards",
        "regulatory",
        "compliance",
        "legislation",
        "regulation",
        "section508",
        "ada",
        "aoda",
        "bitv",
        "rgaa",
        "digitoegankelijk"
    ],
    "author": "Holm Digital AB",
    "license": "MIT",
    "dependencies": {
        "ajv": "^8.18.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "vitest": "^4.0.16"
    }
}